# Copy to apps/mobile/.env (git-ignored) and fill in.
# EXPO_PUBLIC_* values are inlined into the app bundle and are public by design.
# Never put secrets here; the Firebase web config is not secret, security rules are the protection.

# Firebase web app config (Firebase console > Project settings > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Barcode lookup Worker base URL (Phase 4), e.g. https://barcode-api.<account>.workers.dev
EXPO_PUBLIC_API_URL=
