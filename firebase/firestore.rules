rules_version = '2';

// Spec section 5.4, plus: users/{uid} pointers (section 10), atomic household
// bootstrap via getAfter(), createdBy/createdAt integrity on events, and
// non-negative stock on products.
// Rules are the only real protection: the Firebase web config is public.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function isMember(hid) {
      return signedIn() && request.auth.uid in get(householdPath(hid)).data.memberUids;
    }

    // Stock can never go negative, even from a buggy client. The app's Zod
    // schema validates everything else at the boundary.
    function validStock(data) {
      return data.onHand is number && data.onHand >= 0
        && data.container is string;
    }

    // Pet photos live on the pet document as small JPEG data URIs. Cap their
    // size so one bad write can't fill the 1 MiB document (PET_PHOTO_MAX in core).
    function validPetPhoto(data) {
      return !('photo' in data) || data.photo == null
        || (data.photo is string && data.photo.size() <= 200000);
    }

    // Where a user's household lives, so it can be found again after reinstall.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // The pointer may only name a household this user belongs to. getAfter()
      // sees the state after the write, so the bootstrap batch (household +
      // user doc together) passes while pointing at a stranger's household fails.
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string
        && request.auth.uid in getAfter(householdPath(request.resource.data.householdId)).data.memberUids;
      allow delete: if false;
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid];
      // membership is immutable for now
      allow update: if isMember(hid)
        && request.resource.data.memberUids == resource.data.memberUids;
      allow delete: if false;

      match /pets/{id} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validPetPhoto(request.resource.data);
      }

      match /products/{id} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validStock(request.resource.data);

        match /ratings/{rid} {
          allow read, write: if isMember(hid);
        }
      }

      // Append-only ledger.
      match /events/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
